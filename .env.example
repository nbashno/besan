# ==== عام ====
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# ==== قاعدة البيانات ====
DATABASE_URL="postgresql://baysan:baysan@localhost:5432/baysan?schema=public"

# ==== JWT ====
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ==== Telegram ====
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_USERNAME=your_bot
TELEGRAM_WEBAPP_URL=https://your-webapp-url
# نافذة صلاحية initData بالثواني (حماية ضد إعادة الإرسال)
TELEGRAM_INITDATA_MAX_AGE=86400

# ==== Supabase Storage ====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=baysan-files
# صلاحية رابط الرفع/التنزيل الموقّع بالثواني
SIGNED_URL_TTL=3600

# ==== حدود الرفع (قابلة للضبط، لا تُكتب في الكود) ====
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,video/mp4,audio/mpeg,application/zip

# ==== Redis (اختياري في الـMVP) ====
REDIS_URL=

# ==== حدود المعدل ====
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===== الواجهة =====
NEXT_PUBLIC_API_BASE="http://localhost:4000/api/v1"
# للتطوير خارج Telegram فقط — initData اختباري
NEXT_PUBLIC_DEV_INITDATA=""
WEBAPP_URL="https://your-webapp.example.com"
SUPABASE_SERVICE_ROLE_KEY=""
SIGNED_URL_TTL="3600"
