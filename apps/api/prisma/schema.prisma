generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum OrgType {
  SCHOOL_GROUP // Ãƒâ„¢Ã¢â‚¬Â¦ÃƒËœÃ‚Â¤ÃƒËœÃ‚Â³ÃƒËœÃ‚Â³ÃƒËœÃ‚Â© Ãƒâ„¢Ã¢â‚¬Â¦ÃƒËœÃ‚ÂªÃƒËœÃ‚Â¹ÃƒËœÃ‚Â¯ÃƒËœÃ‚Â¯ÃƒËœÃ‚Â© ÃƒËœÃ‚Â§Ãƒâ„¢Ã¢â‚¬Å¾Ãƒâ„¢Ã‚ÂÃƒËœÃ‚Â±Ãƒâ„¢Ã‹â€ ÃƒËœÃ‚Â¹
  SCHOOL       // Ãƒâ„¢Ã¢â‚¬Â¦ÃƒËœÃ‚Â¯ÃƒËœÃ‚Â±ÃƒËœÃ‚Â³ÃƒËœÃ‚Â© Ãƒâ„¢Ã¢â‚¬Â¦ÃƒËœÃ‚Â³ÃƒËœÃ‚ÂªÃƒâ„¢Ã¢â‚¬Å¡Ãƒâ„¢Ã¢â‚¬Å¾ÃƒËœÃ‚Â© (Ãƒâ„¢Ã‚ÂÃƒËœÃ‚Â±ÃƒËœÃ‚Â¹ Ãƒâ„¢Ã‹â€ ÃƒËœÃ‚Â§ÃƒËœÃ‚Â­ÃƒËœÃ‚Â¯)
}

enum Role {
  SUPER_ADMIN
  GROUP_ADMIN
  BRANCH_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum ClassMemberRole {
  TEACHER
  STUDENT
}

enum AssignmentType {
  TEXT
  IMAGE
  PDF
  WORD
  POWERPOINT
  EXCEL
  VIDEO
  AUDIO
  ZIP
  MULTIPLE
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  VIEWED
  GRADED
  RETURNED
}

enum PointReason {
  SUBMISSION_ON_TIME
  HIGH_GRADE
  MANUAL_AWARD
  REWARD_CARD
}

enum NotificationType {
  NEW_ASSIGNMENT
  DEADLINE_REMINDER
  FEEDBACK
  GRADE_PUBLISHED
  ANNOUNCEMENT
  REWARD_CARD
  PRIVATE_MESSAGE
  REWARD
  SYSTEM
}


model Organization {
  id        String    @id @default(cuid())
  name      String
  type      OrgType
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  branches Branch[]

  @@index([type])
}

model Branch {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  users        User[]
  classes      Class[]

  @@index([organizationId])
}


model User {
  id           String    @id @default(cuid())
  telegramId   BigInt    @unique
  username     String?
  firstName    String
  lastName     String?
  photoUrl     String?
  role         Role      @default(STUDENT)
  languageCode String?
  branchId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  branch          Branch?       @relation(fields: [branchId], references: [id])
  memberships     ClassMember[]
  ownedClasses    Class[]       @relation("ClassOwner")
  assignments     Assignment[]  @relation("AssignmentAuthor")
  submissions     Submission[]
  gradesGiven     Grade[]       @relation("Grader")
  notifications   Notification[]
  announcements   Announcement[]
  rewardCards     RewardCard[]  @relation("RewardTeacher")
  receivedCards   RewardCard[]  @relation("RewardStudent")
  pointEntries    PointEntry[]  @relation("PointStudent")
  sentMessages    Message[]     @relation("MsgSender")
  recvMessages    Message[]     @relation("MsgReceiver")
  parentLinks     ParentLink[]  @relation("AsParent")
  childLinks      ParentLink[]  @relation("AsStudent")

  @@index([role])
  @@index([branchId])
  @@index([deletedAt])
}

model ParentLink {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  User @relation("AsParent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("AsStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}


model Class {
  id          String    @id @default(cuid())
  branchId    String?
  name        String
  description String?
  code        String    @unique
  ownerId     String
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  branch        Branch?        @relation(fields: [branchId], references: [id])
  owner         User           @relation("ClassOwner", fields: [ownerId], references: [id])
  members       ClassMember[]
  assignments   Assignment[]
  invites       ClassInvite[]
  announcements Announcement[]

  @@index([ownerId])
  @@index([branchId])
  @@index([archived, deletedAt])
}

model ClassMember {
  id       String          @id @default(cuid())
  classId  String
  userId   String
  role     ClassMemberRole @default(STUDENT)
  joinedAt DateTime        @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
}

model ClassInvite {
  id        String    @id @default(cuid())
  classId   String
  token     String    @unique
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}


model Assignment {
  id          String         @id @default(cuid())
  classId     String
  authorId    String
  title       String
  description String?
  type        AssignmentType @default(TEXT)
  dueAt       DateTime?
  maxGrade    Float?
  phetSlug    String?        // Ãƒâ„¢Ã¢â‚¬Â¦ÃƒËœÃ‚Â¹ÃƒËœÃ‚Â±Ãƒâ„¢Ã¢â‚¬ËœÃƒâ„¢Ã‚Â Ãƒâ„¢Ã¢â‚¬Â¦ÃƒËœÃ‚Â­ÃƒËœÃ‚Â§Ãƒâ„¢Ã†â€™ÃƒËœÃ‚Â§ÃƒËœÃ‚Â© PhET ÃƒËœÃ‚Â§Ãƒâ„¢Ã¢â‚¬Å¾Ãƒâ„¢Ã¢â‚¬Â¦ÃƒËœÃ‚Â±Ãƒâ„¢Ã‚ÂÃƒâ„¢Ã¢â‚¬Å¡ÃƒËœÃ‚Â© (ÃƒËœÃ‚Â±ÃƒËœÃ‚Â§ÃƒËœÃ‚Â¨ÃƒËœÃ‚Â· Ãƒâ„¢Ã‚ÂÃƒâ„¢Ã¢â‚¬Å¡ÃƒËœÃ‚Â·ÃƒËœÃ…â€™ Ãƒâ„¢Ã¢â‚¬Å¾ÃƒËœÃ‚Â§ Ãƒâ„¢Ã¢â‚¬Â¦ÃƒËœÃ‚Â­ÃƒËœÃ‚ÂªÃƒâ„¢Ã‹â€ Ãƒâ„¢Ã¢â‚¬Â°)
  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  author      User         @relation("AssignmentAuthor", fields: [authorId], references: [id])
  attachments FileObject[] @relation("AssignmentFiles")
  submissions Submission[]

  @@index([classId, published])
  @@index([dueAt])
  @@index([deletedAt])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(DRAFT)
  textContent  String?
  version      Int              @default(1)
  isLate       Boolean          @default(false)
  submittedAt  DateTime?
  viewedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User                @relation(fields: [studentId], references: [id])
  files      FileObject[]        @relation("SubmissionFiles")
  history    SubmissionHistory[]
  grade      Grade?

  @@unique([assignmentId, studentId])
  @@index([status])
}

model SubmissionHistory {
  id           String   @id @default(cuid())
  submissionId String
  version      Int
  textContent  String?
  snapshotAt   DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Grade {
  id           String   @id @default(cuid())
  submissionId String   @unique
  graderId     String
  value        Float
  feedback     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  grader     User       @relation("Grader", fields: [graderId], references: [id])
}


model FileObject {
  id           String    @id @default(cuid())
  bucket       String
  path         String
  fileName     String
  mimeType     String
  size         Int
  assignmentId String?
  submissionId String?
  uploadedById String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  assignment Assignment? @relation("AssignmentFiles", fields: [assignmentId], references: [id])
  submission Submission? @relation("SubmissionFiles", fields: [submissionId], references: [id])

  @@index([assignmentId])
  @@index([submissionId])
}


model Announcement {
  id        String    @id @default(cuid())
  classId   String
  authorId  String
  title     String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  class  Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([classId])
}

model Message {
  id         String   @id @default(cuid())
  classId    String?
  senderId   String
  receiverId String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("MsgSender", fields: [senderId], references: [id])
  receiver User @relation("MsgReceiver", fields: [receiverId], references: [id])

  @@index([receiverId, read])
  @@index([senderId, receiverId])
}


model PointEntry {
  id          String      @id @default(cuid())
  branchId    String?
  studentId   String
  awardedById String
  reason      PointReason
  value       Int
  refId       String?
  createdAt   DateTime    @default(now())

  student User @relation("PointStudent", fields: [studentId], references: [id])

  @@index([studentId])
  @@index([branchId])
}

model RewardCard {
  id         String   @id @default(cuid())
  branchId   String?
  studentId  String
  teacherId  String
  title      String
  message    String
  imageUrl   String?
  pointValue Int      @default(0)
  createdAt  DateTime @default(now())

  student User @relation("RewardStudent", fields: [studentId], references: [id])
  teacher User @relation("RewardTeacher", fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([teacherId])
}


model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}


model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
