  published   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  author      User         @relation("AssignmentAuthor", fields: [authorId], references: [id])
  attachments FileObject[] @relation("AssignmentFiles")
  submissions Submission[]

  @@index([classId, published])
  @@index([dueAt])
  @@index([deletedAt])
  questions Question[]
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  status       SubmissionStatus @default(DRAFT)
  textContent  String?
  version      Int              @default(1)
  isLate       Boolean          @default(false)
  submittedAt  DateTime?
  viewedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User                @relation(fields: [studentId], references: [id])
  files      FileObject[]        @relation("SubmissionFiles")
  history    SubmissionHistory[]
  grade      Grade?

  @@unique([assignmentId, studentId])
  @@index([status])
  answers Answer[]
}

model SubmissionHistory {
  id           String   @id @default(cuid())
  submissionId String
  version      Int
  textContent  String?
  snapshotAt   DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Grade {
  id           String   @id @default(cuid())
  submissionId String   @unique
  graderId     String
  value        Float
  feedback     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  grader     User       @relation("Grader", fields: [graderId], references: [id])
}


model FileObject {
  id           String    @id @default(cuid())
  bucket       String
  path         String
  fileName     String
  mimeType     String
  size         Int
  assignmentId String?
  submissionId String?
  uploadedById String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  assignment Assignment? @relation("AssignmentFiles", fields: [assignmentId], references: [id])
  submission Submission? @relation("SubmissionFiles", fields: [submissionId], references: [id])

  @@index([assignmentId])
  @@index([submissionId])
}


model Announcement {
  id        String    @id @default(cuid())
  classId   String
  authorId  String
  title     String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  class  Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([classId])
}

model Message {
  id         String   @id @default(cuid())
  classId    String?
  senderId   String
  receiverId String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("MsgSender", fields: [senderId], references: [id])
  receiver User @relation("MsgReceiver", fields: [receiverId], references: [id])

  @@index([receiverId, read])
  @@index([senderId, receiverId])
}


model PointEntry {
  id          String      @id @default(cuid())
  branchId    String?
  studentId   String
  awardedById String
  reason      PointReason
  value       Int
  refId       String?
  createdAt   DateTime    @default(now())

  student User @relation("PointStudent", fields: [studentId], references: [id])

  @@index([studentId])
  @@index([branchId])
}

model RewardCard {
  id         String   @id @default(cuid())
  branchId   String?
  studentId  String
  teacherId  String
  title      String
  message    String
  imageUrl   String?
  pointValue Int      @default(0)
  createdAt  DateTime @default(now())

  student User @relation("RewardStudent", fields: [studentId], references: [id])
  teacher User @relation("RewardTeacher", fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([teacherId])
}


model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}


model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

enum QuestionType {
  MCQ
  WRITTEN
}

model Question {
  id           String       @id @default(cuid())
  assignmentId String
  type         QuestionType @default(MCQ)
  text         String
  order        Int          @default(0)
  points       Float        @default(1)
  createdAt    DateTime     @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  choices    Choice[]
  answers    Answer[]

  @@index([assignmentId])
}

model Choice {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@index([questionId])
}

model Answer {
  id             String   @id @default(cuid())
  submissionId   String
  questionId     String
  choiceId       String?
  writtenText    String?
  isCorrect      Boolean?
  awardedPoints  Float?
  createdAt      DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choice     Choice?    @relation(fields: [choiceId], references: [id])

  @@index([submissionId])
  @@index([questionId])
}
