enum Role {
  SUPER_ADMIN
  GROUP_ADMIN
  BRANCH_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum ClassMemberRole {
  TEACHER
  STUDENT
}

enum AssignmentType {
  TEXT
  IMAGE
  PDF
  WORD
  POWERPOINT
  EXCEL
  VIDEO
  AUDIO
  ZIP
  MULTIPLE
  QUIZ
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  VIEWED
  GRADED
  RETURNED
}

enum PointReason {
  SUBMISSION_ON_TIME
  HIGH_GRADE
  MANUAL_AWARD
  REWARD_CARD
}

enum NotificationType {
  NEW_ASSIGNMENT
  DEADLINE_REMINDER
  FEEDBACK
  GRADE_PUBLISHED
  ANNOUNCEMENT
  REWARD_CARD
  PRIVATE_MESSAGE
  REWARD
  SYSTEM
}


model Organization {
  id        String    @id @default(cuid())
  name      String
  type      OrgType
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  branches Branch[]

  @@index([type])
}

model Branch {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  users        User[]
  classes      Class[]

  @@index([organizationId])
}


model User {
  id           String    @id @default(cuid())
  telegramId   BigInt    @unique
  username     String?
  firstName    String
  lastName     String?
  photoUrl     String?
  role         Role      @default(STUDENT)
  displayName     String?
  schoolName      String?
  profileComplete Boolean   @default(false)
  languageCode String?
  branchId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  branch          Branch?       @relation(fields: [branchId], references: [id])
  memberships     ClassMember[]
  ownedClasses    Class[]       @relation("ClassOwner")
  assignments     Assignment[]  @relation("AssignmentAuthor")
  submissions     Submission[]
  gradesGiven     Grade[]       @relation("Grader")
  notifications   Notification[]
  announcements   Announcement[]
  rewardCards     RewardCard[]  @relation("RewardTeacher")
  receivedCards   RewardCard[]  @relation("RewardStudent")
  pointEntries    PointEntry[]  @relation("PointStudent")
  sentMessages    Message[]     @relation("MsgSender")
  recvMessages    Message[]     @relation("MsgReceiver")
  parentLinks     ParentLink[]  @relation("AsParent")
  childLinks      ParentLink[]  @relation("AsStudent")

  @@index([role])
  @@index([branchId])
  @@index([deletedAt])
}

model ParentLink {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  User @relation("AsParent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("AsStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}


model Class {
  id          String    @id @default(cuid())
  branchId    String?
  name        String
  description String?
  code        String    @unique
  ownerId     String
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  branch        Branch?        @relation(fields: [branchId], references: [id])
  owner         User           @relation("ClassOwner", fields: [ownerId], references: [id])
  members       ClassMember[]
  assignments   Assignment[]
  invites       ClassInvite[]
  announcements Announcement[]

  @@index([ownerId])
  @@index([branchId])
  @@index([archived, deletedAt])
}

model ClassMember {
  id       String          @id @default(cuid())
  classId  String
  userId   String
  role     ClassMemberRole @default(STUDENT)
  joinedAt DateTime        @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
}

model ClassInvite {
  id        String    @id @default(cuid())
  classId   String
  token     String    @unique
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int       @default(0)
  createdAt DateTime  @default(now())

