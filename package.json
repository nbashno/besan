{
  "name": "baysan-edu",
  "private": true,
  "version": "1.0.0",
  "description": "بيسان التعليمية - منصة تواصل المعلم والطالب",
  "scripts": {
    "dev:api": "pnpm --filter @baysan/api start:dev",
    "dev:web": "pnpm --filter @baysan/web dev",
    "build": "pnpm -r build",
    "prisma:generate": "pnpm --filter @baysan/api prisma:generate",
    "prisma:migrate": "pnpm --filter @baysan/api prisma:migrate"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": { "node": ">=20" }
}
